, {"LS CER Ending Date", type datetime}, {"CR complete", type text}, {"CR Declarant", type text}, {"CR File number", type text}, {"CR AWB arrival", Int64.Type}, {"CR Customs export declaration to be sold", type any}, {"CR Information source", type text}, {"CR Return packing sheet ref.", type text}, {"CR Supply Origin", type text}, {"CR Declared customs value", type number}, {"CR Customs value currency", type text}, {"CR Import regime", type text}, {"CR Import value (euro)", Int64.Type}, {"CR Customs information date", type datetime}, {"CR Physical reception date", type datetime}, {"reason", type any}, {"comment_rm", type text}, {"comment_shipping", type text}, {"comment_return_confirmation", type text}, {"comment_acknowledgment", type text}, {"comment_repair_report", type any}, {"end_date_validity_customer", type datetime}}),
    #"Type modifié2" = Table.TransformColumnTypes(#"Type modifié",{{"end_date_validity_customer", type date}}),
    #"Lignes filtrées" = Table.SelectRows(#"Type modifié2", each ([Status] = "Not created" or [Status] = "Resource requested")),
    #"Lignes filtrées1" = Table.SelectRows(#"Lignes filtrées", each not Text.StartsWith([CSR reference], "EADS_TS_")),
    #"Type modifié1" = Table.TransformColumnTypes(#"Lignes filtrées1",{{"requirements_date", type date}}),
    // Ajouter une colonne personnalisée pour la différence en jours
    AddDiffColumn = Table.AddColumn(#"Type modifié1", "Nb Jours", each Duration.Days(DateDuJour - [requirements_date]), Int64.Type),
    #"Colonne conditionnelle ajoutée" = Table.AddColumn(AddDiffColumn, "Classement Nb jours", each if [Nb Jours] <= dureebas then "< " & dureebastexte & "j" else if [Nb Jours] <= dureehaut then dureebastexte & "j < x < " & dureehauttexte & "j" else "> " & dureehauttexte & "j"),
    #"Colonne conditionnelle ajoutée1" = Table.AddColumn(#"Colonne conditionnelle ajoutée", "metro", each 
    if [Type RM] = "Metrological Verification by Standard Exchange" then
        if [end_date_validity_customer] = null then
            if [requirements_date] > DateDuJour then 
                "metro still in time" 
            else [Classement Nb jours] 
        else
            if [end_date_validity_customer] > DateDuJour then 
                "metro still in time" 
            else [Classement Nb jours] 
    else [Classement Nb jours]),
    #"Colonnes supprimées" = Table.RemoveColumns(#"Colonne conditionnelle ajoutée1",{"Classement Nb jours"}),
    #"Colonnes renommées" = Table.RenameColumns(#"Colonnes supprimées",{{"metro", "Classement Nb jours"}}),
